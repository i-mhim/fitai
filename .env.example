# Local development values only. Never commit a real JWT secret.
# Docker Compose binds the PostgreSQL host port to 5433 (container port remains 5432).
DATABASE_URL=postgresql+psycopg://fitai:fitai_local_dev_only@localhost:5433/fitai
# Run: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Then paste the random value below in your untracked .env file.
FITAI_JWT_SECRET=
